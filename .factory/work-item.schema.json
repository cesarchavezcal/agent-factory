{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory work item",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "stage", "status", "builder"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "source": {
      "type": "string",
      "description": "Chat, issue URL, or pasted brief"
    },
    "stage": {
      "type": "string",
      "enum": [
        "intake",
        "triage",
        "planning",
        "building",
        "reviewing",
        "handoff",
        "complete",
        "cancelled"
      ]
    },
    "status": {
      "type": "string",
      "enum": ["open", "blocked", "complete", "cancelled"]
    },
    "builder": { "type": "string", "const": "poteto-mode" },
    "primarySkill": { "type": "string" },
    "planPath": { "type": "string" },
    "ticketIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verifySkill": { "type": "string" },
    "evidenceDir": { "type": "string" },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "decisions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "waitingOn": {
      "type": "string",
      "enum": ["none", "merge", "blocked"]
    }
  }
}
